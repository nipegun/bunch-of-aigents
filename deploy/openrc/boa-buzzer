#!/sbin/openrc-run

# Bunch of AIgents - watches the board and starts a run when a card is due.

name="boa-buzzer"
description="Bunch of AIgents - Kanban buzzer"

command="/opt/boa/venv/bin/python3"
command_args="-m backend.core.buzzer"
command_user="boa:boa"
directory="/opt/boa/webapp"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0

export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH=/opt/boa/webapp
export BOA_BASE_DIR=/opt/boa

depend() {
  need net boa-exec
}
