[Unit]
Description=Bunch of AIgents - TLS proxy
Documentation=https://github.com/nipegun/bunch-of-aigents
After=network-online.target boa-web.service
Wants=network-online.target
Requires=boa-web.service

[Service]
Type=simple
User=boa
Group=boa
# -db keeps it in the foreground, which is what systemd wants.
ExecStart=/usr/sbin/haproxy -f /opt/boa/config/haproxy.cfg -db
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5

# This is the only component listening on a port, and the one capability it is
# given is the one it cannot do without: binding 80 and 443 when the user chose
# to serve them directly. On the default ports - 11080 and 11443, behind the
# machine's own proxy - it is never used, and granting it changes nothing:
# CAP_NET_BIND_SERVICE lets a process bind a low port and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/boa/logs

[Install]
WantedBy=multi-user.target
