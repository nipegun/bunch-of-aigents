[Unit]
Description=Bunch of AIgents - Agent API
Documentation=https://github.com/nipegun/bunch-of-aigents
After=network.target
PartOf=boa-web.service

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/opt/boa/webapp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=BOA_BASE_DIR=/opt/boa
# systemd creates this owned by the service user, which is the
# whole point: a directory root owns is one boa cannot write to.
RuntimeDirectory=boa-agent
RuntimeDirectoryMode=0755
ExecStart=/opt/boa/venv/bin/python3 -m backend.core.agent_api
Restart=on-failure
RestartSec=5

# This service holds the kanban database and the channel credentials on behalf
# of agents that may not touch either. It needs no privilege of its own.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/boa/kanban /opt/boa/db /opt/boa/logs

[Install]
WantedBy=multi-user.target
