[Unit]
Description=Bunch of AIgents - Telegram listener
Documentation=https://github.com/nipegun/bunch-of-aigents
After=network.target boa-exec.service
# It can do nothing without the executor: writing into an agent's 0700 home and
# starting a run as that agent are the executor's job, and this service has no
# privileges of its own.
Requires=boa-exec.service
PartOf=boa-web.service

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/opt/boa/webapp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=BOA_BASE_DIR=/opt/boa
ExecStart=/opt/boa/venv/bin/python3 -m backend.core.telegram_listener
Restart=on-failure
RestartSec=5

# It reads the channel configuration, keeps two small tables and talks to a
# socket. Nothing else. `config` is writable because the offset - the last
# Telegram update dealt with - lives there.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/boa/audio /opt/boa/config /opt/boa/db /opt/boa/logs

[Install]
WantedBy=multi-user.target
