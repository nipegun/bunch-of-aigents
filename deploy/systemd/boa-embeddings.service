[Unit]
Description=Bunch of AIgents - Local document embeddings
After=local-fs.target

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/opt/boa/webapp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=BOA_BASE_DIR=/opt/boa
RuntimeDirectory=boa-embeddings
RuntimeDirectoryMode=0755
ExecStart=/opt/boa/venv/bin/python3 -m backend.core.rag_runtime --serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/boa-embeddings
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
